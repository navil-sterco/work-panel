# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# The name of the tab/worksheet inside the sheet to write to
GOOGLE_SHEET_TAB=Sheet1

# Service account credentials — from the JSON key file Google gives you
# when you create a service account in Google Cloud Console.
# Paste the "client_email" and "private_key" values below.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Keep the \n characters literally as \n (do not replace with real newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Port for the Express server
PORT=5000

# Used to auto-clean up the "Work description" text into correct English,
# formatted as 5 bullet points, before it's saved to the sheet.
# Groq has a free API tier (no credit card needed) — get a key at:
# https://console.groq.com/keys
GROQ_API_KEY=
